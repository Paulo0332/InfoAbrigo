# Firebase: o banco do aplicativo. Copie este arquivo para .env e preencha.
# Sem estas chaves, os dados ficam só no aparelho.
# Os valores estão no console do Firebase, nas configurações do projeto.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Para testar com o emulador do Firebase (npm run emulador), use estas no lugar das
# de cima, com o IP deste computador:
#   EXPO_PUBLIC_FIREBASE_API_KEY=chave-falsa
#   EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-infoabrigo
#   EXPO_PUBLIC_FIREBASE_DATABASE_URL=http://192.168.0.10:9000/?ns=demo-infoabrigo-default-rtdb
#   EXPO_PUBLIC_FIREBASE_EMULATOR=192.168.0.10

# API do InfoAbrigo: fotos, selo verificado, recomendações, painel e denúncias.
# Vazio: esses recursos não aparecem, e o resto funciona igual.
# Celular e computador na mesma rede: use o IP do computador, nunca "localhost",
# porque para o celular "localhost" é ele mesmo. Exemplos:
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:5000   (python app.py)
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:5001   (Docker)
# Publicado: o endereço https da hospedagem.
EXPO_PUBLIC_API_URL=
