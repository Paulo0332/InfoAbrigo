# Endereço da API do InfoAbrigo. Copie este arquivo para .env e preencha.
#
# Vazio: o aplicativo funciona só com os dados do aparelho.
# Celular e computador na mesma rede: use o IP do computador, nunca "localhost",
# porque para o celular "localhost" é ele mesmo. Exemplos:
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:5000   (python app.py)
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:5001   (Docker)
# Publicado: o endereço https da hospedagem.
EXPO_PUBLIC_API_URL=

# Firebase, para o aviso em tempo real entre celulares. Sem estas chaves o
# aplicativo funciona igual, e a novidade aparece ao abrir a tela de novo.
# Os valores estão no console do Firebase, nas configurações do projeto.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
