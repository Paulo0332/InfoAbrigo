# Endereço da API do InfoAbrigo. Copie este arquivo para .env e preencha.
#
# Vazio: o aplicativo funciona só com os dados do aparelho.
# Celular e computador na mesma rede: use o IP do computador, nunca "localhost",
# porque para o celular "localhost" é ele mesmo. Exemplo:
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# Publicado: o endereço https da hospedagem. Exemplo:
#   EXPO_PUBLIC_API_URL=https://infoabrigo-api.onrender.com
EXPO_PUBLIC_API_URL=
