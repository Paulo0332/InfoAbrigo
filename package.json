    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.19.1",
    "axios": "^1.21.0",
    "expo": "~58.0.22",
    "expo-calendar": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.2.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.13",
    "react-test-renderer": "^19.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backend/",
      "/__tests__/apoio/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/backend/"
    ],
    "moduleNameMapper": {
      "^expo-sqlite$": "<rootDir>/__tests__/apoio/expo-sqlite.js",
      "^expo-secure-store$": "<rootDir>/__tests__/apoio/expo-secure-store.js",
      "^expo-crypto$": "<rootDir>/__tests__/apoio/expo-crypto.js",
      "^expo-image-manipulator$": "<rootDir>/__tests__/apoio/expo-image-manipulator.js",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^axios$": "<rootDir>/__tests__/apoio/axios.js",
      "^@react-native-community/netinfo$": "@react-native-community/netinfo/jest/netinfo-mock.js"
    }
  }
}
