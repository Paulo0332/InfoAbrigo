# Banco MySQL. Use 127.0.0.1 para rodar a API fora do Docker.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=infoabrigo

# Firebase. O arquivo da conta de serviço é secreto: fica fora do repositório.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CREDENCIAIS=conta-de-servico.json

# Para testar com o emulador, apague as três linhas acima e use estas:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

PORT=5000
