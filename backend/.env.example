# Banco MySQL. Use 127.0.0.1 para rodar a API fora do Docker.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=infoabrigo

# Texto longo e aleatório que assina as sessões. Gere um com:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SEGREDO=troque-este-valor

PORT=5000
